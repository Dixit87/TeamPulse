@model IEnumerable<TeamPulse.ViewModels.AssetVM>
@{
    ViewData["Title"] = "IT Asset Registry";
}

<style>
    :root {
        --asset-primary: #4f46e5;
        --asset-bg: #f8fafc;
    }

    /* Page Header Overhaul */
    .asset-header {
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.5rem 0;
        margin-bottom: 2rem;
    }

    .btn-add-asset {
        border-radius: 12px;
        font-weight: 600;
        padding: 10px 24px;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        transition: 0.3s;
    }

        .btn-add-asset:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(79, 70, 229, 0.3);
        }

    /* Modern Table UI */
    .asset-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.03);
        overflow: hidden;
    }

    .table-asset thead th {
        background: #f1f5f9;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: #475569;
        border: none;
        padding: 1.25rem 1rem;
    }

    .table-asset tbody tr {
        transition: 0.2s;
        border-bottom: 1px solid #f1f5f9;
    }

        .table-asset tbody tr:hover {
            background-color: #f8fafc;
        }

    /* Asset Identification */
    .asset-icon-box {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 1.1rem;
    }

    .icon-laptop {
        background: #e0f2fe;
        color: #0ea5e9;
    }

    .icon-mobile {
        background: #fef3c7;
        color: #d97706;
    }

    .icon-desktop {
        background: #dcfce7;
        color: #166534;
    }

    .icon-acc {
        background: #f1f5f9;
        color: #64748b;
    }

    /* Status Pills */
    .status-pill {
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
    }

    .status-available {
        background: #dcfce7;
        color: #166534;
    }

    .status-assigned {
        background: #fef9c3;
        color: #854d0e;
    }

    /* Input Modernization */
    .form-control-modern {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 0.7rem;
        background: #f8fafc;
        transition: 0.3s;
    }

        .form-control-modern:focus {
            border-color: var(--asset-primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }
</style>

<div class="asset-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="font-weight-bold text-dark mb-1">Resource Management</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 m-0 small">
                        <li class="breadcrumb-item"><a href="#">Inventory</a></li>
                        <li class="breadcrumb-item active">IT Assets</li>
                    </ol>
                </nav>
            </div>
            <button class="btn btn-primary btn-add-asset" data-toggle="modal" data-target="#addAssetModal">
                <i class="fas fa-plus-circle mr-2"></i> Register New Asset
            </button>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-lg shadow-sm border-left border-primary">
                    <small class="text-muted text-uppercase font-weight-bold">Total Valuation</small>
                    <h4 class="font-weight-bold mb-0">₹ @Model.Sum(x => x.Price).ToString("N0")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-lg shadow-sm border-left border-success">
                    <small class="text-muted text-uppercase font-weight-bold">Ready to Deploy</small>
                    <h4 class="font-weight-bold mb-0 text-success">@Model.Count(x => x.Status == "Available")</h4>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-custom bg-white border-left border-success shadow-sm alert-dismissible fade show mb-4">
                <i class="fas fa-check-circle text-success mr-2"></i> @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        <div class="card asset-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-asset mb-0 align-middle">
                        <thead>
                            <tr>
                                <th class="pl-4">Hardware Item</th>
                                <th>Category</th>
                                <th>Identifier (S/N)</th>
                                <th class="text-right">Acquisition Cost</th>
                                <th class="text-center">Operational Status</th>
                                <th class="text-center">Control</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    var iconClass = item.AssetType switch
                                    {
                                        "Laptop" => "icon-laptop",
                                        "Mobile" => "icon-mobile",
                                        "Desktop" => "icon-desktop",
                                        _ => "icon-acc"
                                    };
                                    var iconImg = item.AssetType switch
                                    {
                                        "Laptop" => "fa-laptop",
                                        "Mobile" => "fa-mobile-alt",
                                        "Desktop" => "fa-desktop",
                                        _ => "fa-headphones"
                                    };

                                    <tr>
                                        <td class="pl-4">
                                            <div class="d-flex align-items-center">
                                                <div class="asset-icon-box @iconClass shadow-sm">
                                                    <i class="fas @iconImg"></i>
                                                </div>
                                                <div class="font-weight-bold text-dark">@item.AssetName</div>
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <span class="text-muted font-weight-bold small">@item.AssetType</span>
                                        </td>
                                        <td class="align-middle">
                                            <code class="px-2 py-1 bg-light rounded text-dark small">@item.SerialNumber</code>
                                        </td>
                                        <td class="text-right align-middle font-weight-bold">
                                            ₹ @item.Price.ToString("N0")
                                        </td>
                                        <td class="text-center align-middle">
                                            @if (item.Status == "Available")
                                            {
                                                <span class="status-pill status-available">
                                                    <i class="fas fa-check-circle mr-1 small"></i> In Stock
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-assigned">
                                                    <i class="fas fa-user-tag mr-1 small"></i> In Use
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center align-middle">
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm rounded-circle border" data-toggle="dropdown">
                                                    <i class="fas fa-ellipsis-v text-muted"></i>
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-right shadow-lg border-0 rounded-lg">
                                                    <a class="dropdown-item py-2" href="#"><i class="fas fa-edit mr-2 text-primary"></i> Edit Specs</a>
                                                    <a class="dropdown-item py-2 text-danger" href="#"><i class="fas fa-trash-alt mr-2"></i> Retire Asset</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" style="width: 80px; opacity: 0.2;" />
                                        <h6 class="mt-3 text-muted">Warehouse Empty. Please add new assets.</h6>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="addAssetModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-xl" style="border-radius: 24px;">
            <div class="modal-header bg-white border-0 p-4">
                <h5 class="modal-title font-weight-bold text-dark"><i class="fas fa-laptop-code text-primary mr-2"></i>Asset Entry</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <form asp-action="SaveAsset" method="post">
                <div class="modal-body p-4 pt-0">
                    <div class="form-group mb-4">
                        <label class="small font-weight-bold text-muted text-uppercase">Asset Model / Name</label>
                        <input type="text" name="AssetName" class="form-control form-control-modern" required placeholder="e.g. MacBook Pro M3 Max" />
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="small font-weight-bold text-muted text-uppercase">Resource Category</label>
                                <select name="AssetType" class="form-control form-control-modern custom-select" required>
                                    <option value="Laptop">Laptop</option>
                                    <option value="Mobile">Mobile</option>
                                    <option value="Desktop">Desktop</option>
                                    <option value="Accessory">Accessory</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="small font-weight-bold text-muted text-uppercase">Price (₹)</label>
                                <input type="number" name="Price" class="form-control form-control-modern" placeholder="0.00" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-0">
                        <label class="small font-weight-bold text-muted text-uppercase">Serial Number / Unique ID</label>
                        <input type="text" name="SerialNumber" class="form-control form-control-modern" placeholder="ST-XXXXXXXXX" />
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow">Add to Inventory</button>
                </div>
            </form>
        </div>
    </div>
</div>