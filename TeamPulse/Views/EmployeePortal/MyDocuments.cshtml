@model IEnumerable<TeamPulse.Models.TblEmployeeDocument>
@{
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    ViewData["Title"] = "My Document Vault";
}

<style>
    :root {
        --dash-primary: #4361ee;
        --bg-soft: #f8f9fc;
    }

    body {
        background-color: var(--bg-soft);
        font-family: 'Inter', sans-serif;
    }

    /* Vault Card Design */
    .doc-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #f1f5f9;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        overflow: hidden;
        position: relative;
    }

        .doc-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            border-color: #e2e8f0;
        }

    .doc-icon-wrapper {
        background: #f8f9fc;
        padding: 40px 20px;
        text-align: center;
        border-bottom: 1px solid #f1f5f9;
        position: relative;
    }

    .doc-icon {
        font-size: 4rem;
        margin-bottom: 15px;
        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
    }

    .doc-details {
        padding: 20px;
    }

    .btn-download {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: var(--dash-primary);
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: 0.3s;
    }

        .btn-download:hover {
            background: var(--dash-primary);
            color: #fff;
            transform: scale(1.1);
        }
</style>

<div class="container-fluid py-4">

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="font-weight-bold text-dark mb-1"><i class="fas fa-shield-alt text-success mr-2"></i>Secure Document Vault</h2>
            <p class="text-muted mb-0">Your official company documents, ID proofs, and signed agreements.</p>
        </div>
        <div class="col-md-4 text-md-right mt-3 mt-md-0">
            <div class="bg-white px-4 py-2 rounded-pill shadow-sm d-inline-block border">
                <span class="font-weight-bold text-dark">Total Files:</span>
                <span class="badge badge-primary badge-pill ml-2" style="font-size: 1rem;">@ViewBag.TotalDocs</span>
            </div>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var doc in Model)
            {
                // Smart Icon Logic based on File Extension
                string ext = System.IO.Path.GetExtension(doc.FilePath)?.ToLower() ?? "";
                string iconClass = "fa-file-alt text-secondary"; // Default Icon

                if (ext == ".pdf") iconClass = "fa-file-pdf text-danger";
                else if (ext == ".png" || ext == ".jpg" || ext == ".jpeg") iconClass = "fa-file-image text-success";
                else if (ext == ".doc" || ext == ".docx") iconClass = "fa-file-word text-primary";
                else if (ext == ".xls" || ext == ".xlsx") iconClass = "fa-file-excel text-success";

                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="doc-card d-flex flex-column">

                        <div class="doc-icon-wrapper">
                            <i class="fas @iconClass doc-icon"></i>
                            <h5 class="font-weight-bold text-dark mb-0 text-truncate" title="@doc.DocumentName">@doc.DocumentName</h5>
                            <small class="badge badge-light border mt-2 text-uppercase">@ext.Replace(".", "") FILE</small>
                        </div>

                        <div class="doc-details bg-white text-center flex-grow-1 d-flex flex-column justify-content-between">
                            <div>
                                <small class="text-muted d-block font-weight-bold mb-1">UPLOADED ON</small>
                                <div class="text-dark font-weight-bold mb-3">
                                    <i class="far fa-calendar-check text-primary mr-1"></i> @doc.UploadedDate?.ToString("dd MMM yyyy")
                                </div>
                            </div>

                            <a href="@Url.Content("~/uploads/documents/" + doc.FilePath)" download="@(doc.DocumentName + ext)" class="btn btn-primary btn-sm btn-block rounded-pill shadow-sm mt-auto font-weight-bold">
                                <i class="fas fa-download mr-1"></i> Download
                            </a>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 bg-white rounded-lg shadow-sm border mt-3">
                <i class="fas fa-box-open fa-3x text-muted mb-3 opacity-25"></i>
                <h5 class="font-weight-bold text-dark">Your Vault is Empty</h5>
                <p class="text-muted mb-0">No documents have been uploaded to your profile by the HR department yet.</p>
            </div>
        }
    </div>

</div>