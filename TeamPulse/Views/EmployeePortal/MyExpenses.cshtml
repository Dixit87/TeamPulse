@model IEnumerable<TeamPulse.Models.TblExpense>
@{
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    ViewData["Title"] = "Expense Claims";
    System.Globalization.CultureInfo indianCulture = new System.Globalization.CultureInfo("hi-IN");
}

<style>
    :root {
        --dash-primary: #4361ee;
        --bg-soft: #f8f9fc;
    }

    body {
        background-color: var(--bg-soft);
        font-family: 'Inter', sans-serif;
    }

    .claim-card {
        background: #fff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        padding: 20px;
        transition: 0.3s;
    }

        .claim-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        }

    .cat-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.2rem;
    }

    .cat-travel {
        background: #e0f2fe;
        color: #0ea5e9;
    }

    .cat-food {
        background: #ffedd5;
        color: #f97316;
    }

    .cat-office {
        background: #f3e8ff;
        color: #a855f7;
    }

    .cat-other {
        background: #f1f5f9;
        color: #64748b;
    }
</style>

<div class="container-fluid py-4">

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="font-weight-bold text-dark mb-1"><i class="fas fa-wallet text-primary mr-2"></i>Expense Reimbursement</h2>
            <p class="text-muted mb-0">Claim your business expenses, travel bills, and view approval status.</p>
        </div>
        <div class="col-md-4 text-md-right mt-3 mt-md-0">
            <button class="btn btn-primary font-weight-bold shadow-sm rounded-pill px-4" data-toggle="modal" data-target="#claimModal">
                <i class="fas fa-plus mr-2"></i> Submit New Claim
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; border-left: 5px solid var(--dash-primary) !important;">
        <div class="card-body d-flex justify-content-between align-items-center p-4">
            <div>
                <small class="text-uppercase text-muted font-weight-bold">Total Claimed Amount (Lifetime)</small>
                <h2 class="font-weight-bold text-dark mb-0">@ViewBag.TotalClaimed.ToString("C", indianCulture)</h2>
            </div>
            <i class="fas fa-money-check-alt fa-3x text-primary opacity-25"></i>
        </div>
    </div>

    <h5 class="font-weight-bold mb-3 mt-4"><i class="fas fa-list-ul text-secondary mr-2"></i>My Claim History</h5>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var claim in Model)
            {
                var catClass = claim.Category == "Travel" ? "cat-travel" : claim.Category == "Food" ? "cat-food" : claim.Category == "Office" ? "cat-office" : "cat-other";
                var iconClass = claim.Category == "Travel" ? "fa-car" : claim.Category == "Food" ? "fa-utensils" : claim.Category == "Office" ? "fa-building" : "fa-receipt";

                // 🚀 SMART STATUS LOGIC (Teeno Status handle kiye)
                bool isPending = claim.Description != null && claim.Description.Contains("[PENDING APPROVAL]");
                bool isRejected = claim.Description != null && claim.Description.Contains("[REJECTED]");

                // Description me se bracket wale tag hata kar sirf asli note dikhane ke liye
                string cleanDesc = claim.Description?.Replace("[PENDING APPROVAL]", "").Replace("[REJECTED]", "").Trim();

                <div class="col-md-6 mb-3">
                    <div class="claim-card d-flex align-items-center">
                        <div class="cat-icon @catClass mr-3"><i class="fas @iconClass"></i></div>
                        <div class="flex-grow-1">
                            <h6 class="font-weight-bold text-dark mb-1">@claim.ExpenseTitle</h6>
                            <div class="small text-muted mb-1"><i class="far fa-calendar-alt mr-1"></i> @claim.ExpenseDate.ToString("dd MMM yyyy") &bull; @claim.Category</div>
                            @if (!string.IsNullOrEmpty(cleanDesc))
                            {
                                <div class="small text-secondary font-italic">"@cleanDesc"</div>
                            }
                        </div>
                        <div class="text-right ml-3">
                            <h5 class="font-weight-bold text-dark mb-1">@claim.Amount.ToString("C", indianCulture)</h5>

                            @if (isPending)
                            {
                                <span class="badge badge-warning text-dark px-2 py-1" style="border-radius: 6px;"><i class="fas fa-hourglass-half mr-1"></i> Pending</span>
                                <a href="@Url.Action("DeleteMyClaim", new { id = claim.ExpenseID })" class="btn btn-sm btn-outline-danger border-0 rounded-circle ml-1" title="Delete Mistake" onclick="return confirm('Are you sure you want to cancel and delete this claim?');">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            }
                            else if (isRejected)
                            {
                                <span class="badge badge-danger px-2 py-1" style="border-radius: 6px;"><i class="fas fa-times-circle mr-1"></i> Rejected</span>
                            }
                            else
                            {
                                <span class="badge badge-success px-2 py-1" style="border-radius: 6px;"><i class="fas fa-check-circle mr-1"></i> Settled</span>
                            }

                            @if (!string.IsNullOrEmpty(claim.ReceiptImage))
                            {
                                <a href="~/uploads/receipts/@claim.ReceiptImage" target="_blank" class="btn btn-sm btn-light border rounded-circle ml-1 mt-1" title="View Bill"><i class="fas fa-paperclip text-primary"></i></a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 bg-white rounded-lg shadow-sm border mt-3">
                <i class="fas fa-wallet fa-3x text-muted mb-3 opacity-25"></i>
                <h5 class="font-weight-bold text-dark">No Claims Found</h5>
                <p class="text-muted mb-0">You haven't submitted any expense reimbursement requests yet.</p>
            </div>
        }
    </div>

</div>

<div class="modal fade" id="claimModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="font-weight-bold"><i class="fas fa-receipt text-primary mr-2"></i>Submit Expense Claim</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <form asp-action="SubmitExpenseClaim" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="form-group mb-3">
                        <label class="small font-weight-bold text-uppercase text-muted">Title (What was this for?)</label>
                        <input type="text" name="ExpenseTitle" class="form-control" placeholder="e.g. Client Meeting Cab Fare" required />
                    </div>

                    <div class="row">
                        <div class="col-6 form-group mb-3">
                            <label class="small font-weight-bold text-uppercase text-muted">Amount (₹)</label>
                            <input type="number" name="Amount" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-6 form-group mb-3">
                            <label class="small font-weight-bold text-uppercase text-muted">Date of Expense</label>
                            <input type="date" name="ExpenseDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="small font-weight-bold text-uppercase text-muted">Category</label>
                        <select name="Category" class="form-control">
                            <option value="Travel">Travel & Transport</option>
                            <option value="Food">Meals & Entertainment</option>
                            <option value="Office">Office Supplies / Internet</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="small font-weight-bold text-uppercase text-muted">Upload Receipt/Bill (Optional)</label>
                        <div class="custom-file">
                            <input type="file" name="ReceiptFile" class="custom-file-input" id="billFile" accept=".jpg,.jpeg,.png,.pdf">
                            <label class="custom-file-label" for="billFile">Choose file...</label>
                        </div>
                    </div>

                    <div class="form-group mb-2">
                        <label class="small font-weight-bold text-uppercase text-muted">Additional Details</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Any context for the HR/Manager..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-sm font-weight-bold" style="border-radius: 10px;">Submit Claim</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.querySelector('.custom-file-input').addEventListener('change', function(e) {
        var fileName = document.getElementById("billFile").files[0].name;
        var nextSibling = e.target.nextElementSibling;
        nextSibling.innerText = fileName;
    });
</script>