@{
    ViewData["Title"] = "Manual Attendance Correction";
}

<style>
    /* Card & Section Styling */
    .correction-card {
        border-radius: 16px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        background: #fff;
    }

    .correction-header {
        background: linear-gradient(45deg, #f39c12, #e67e22);
        color: white;
        border-radius: 16px 16px 0 0 !important;
        padding: 20px;
    }

    /* Input Styling */
    .form-label {
        font-weight: 600;
        color: #4b5563;
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .custom-input {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 10px 15px;
        height: 45px !important;
        transition: all 0.2s;
    }

        .custom-input:focus {
            border-color: #f39c12;
            box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.1);
        }

    /* Info Box */
    .status-box {
        border-radius: 12px;
        background-color: #f8fafc;
        border: 1px dashed #cbd5e1;
        padding: 20px;
        margin-top: 20px;
    }

    /* Button Styling */
    .btn-update-record {
        background: #f39c12;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        padding: 12px 30px;
        transition: all 0.3s;
    }

        .btn-update-record:hover {
            background: #d35400;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(243, 156, 18, 0.3);
            color: white;
        }

    /* Animation */
    .fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h3 class="font-weight-bold text-dark mb-1">Manual Entry & Correction</h3>
            <p class="text-muted small">Update or correct attendance logs for specific dates.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4" style="border-left: 5px solid #2ecc71 !important;">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                    <button class="close" data-dismiss="alert">&times;</button>
                </div>
            }

            <div class="card correction-card">
                <div class="card-header correction-header">
                    <h5 class="mb-0"><i class="fas fa-user-edit mr-2"></i> Record Modification Form</h5>
                </div>

                <form asp-action="SaveManualEntry" method="post" id="correctionForm">
                    <div class="card-body p-4">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Employee</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-white border-right-0 custom-input"><i class="fas fa-user text-muted"></i></span>
                                        </div>
                                        <select name="EmployeeID" id="ddlEmp" class="form-control custom-input border-left-0 shadow-none" asp-items="ViewBag.Employees" onchange="fetchData()">
                                            <option value="">Search Employee...</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Attendance Date</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-white border-right-0 custom-input"><i class="fas fa-calendar-alt text-muted"></i></span>
                                        </div>
                                        <input type="date" name="AttendanceDate" id="txtDate" class="form-control custom-input border-left-0 shadow-none" value="@DateTime.Now.ToString("yyyy-MM-dd")" onchange="fetchData()" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center py-2 text-muted small">
                            <hr style="width: 50%; display: inline-block; vertical-align: middle;">
                            <span class="mx-2">Correction Details</span>
                            <hr style="width: 50%; display: inline-block; vertical-align: middle;">
                        </div>

                        <div class="status-box fade-in" id="correctionDetails">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group mb-0">
                                        <label class="form-label text-primary">Attendance Status</label>
                                        <select name="Status" id="ddlStatus" class="form-control custom-input font-weight-bold">
                                            <option value="P" class="text-success">Present (P)</option>
                                            <option value="A" class="text-danger">Absent (A)</option>
                                            <option value="H" class="text-warning">Half Day (H)</option>
                                            <option value="L" class="text-primary">On Leave (L)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group mb-0">
                                        <label class="form-label">Clock-In Time</label>
                                        <input type="time" name="InTime" id="txtIn" class="form-control custom-input" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group mb-0">
                                        <label class="form-label">Clock-Out Time</label>
                                        <input type="time" name="OutTime" id="txtOut" class="form-control custom-input" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group mb-0">
                                        <label class="form-label">Correction Reason</label>
                                        <input type="text" name="Remarks" id="txtRem" class="form-control custom-input" placeholder="e.g. Forgot to punch" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top p-4 text-center">
                        <button type="reset" class="btn btn-light px-4 mr-2">Clear Form</button>
                        <button type="submit" class="btn btn-update-record shadow">
                            <i class="fas fa-check-double mr-1"></i> Apply Correction
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fetchData() {
            var empId = $("#ddlEmp").val();
            var date = $("#txtDate").val();

            if (empId && date) {
                // Loading state UI (Optional)
                $("#correctionDetails").css("opacity", "0.5");

                $.get("/Attendance/GetAttendanceData?empId=" + empId + "&date=" + date, function (data) {
                    $("#correctionDetails").css("opacity", "1");
                    if (data.success) {
                        if (data.found) {
                            $("#ddlStatus").val(data.status);
                            $("#txtIn").val(data.inTime);
                            $("#txtOut").val(data.outTime);
                            $("#txtRem").val(data.remarks);
                            // Highlight that existing record found
                        } else {
                            $("#ddlStatus").val("A");
                            $("#txtIn").val("");
                            $("#txtOut").val("");
                            $("#txtRem").val("");
                        }
                    }
                });
            }
        }
    </script>
}