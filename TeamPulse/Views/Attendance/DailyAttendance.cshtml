@model List<TeamPulse.ViewModels.AttendanceVM>
@{
    ViewData["Title"] = "Daily Attendance";
    var selectedDate = (DateOnly)ViewBag.SelectedDate;
}

<style>
    .attendance-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        overflow: hidden;
    }

    .table thead th {
        background-color: #f8f9fa;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: #6c757d;
        border-top: none;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        color: white;
    }

    /* Modern Radio/Checkbox Toggles */
    .status-toggle input[type="checkbox"] {
        display: none;
    }

    .status-toggle label {
        margin-bottom: 0;
        padding: 5px 12px;
        cursor: pointer;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
        border: 1px solid #dee2e6;
        color: #6c757d;
    }

    .check-p:checked + label {
        background-color: #d1e7dd;
        border-color: #a3cfbb;
        color: #0f5132;
    }

    .check-l:checked + label {
        background-color: #fff3cd;
        border-color: #ffe69c;
        color: #664d03;
    }

    .check-hd:checked + label {
        background-color: #cff4fc;
        border-color: #9eeaf9;
        color: #055160;
    }

    .check-lv:checked + label {
        background-color: #f8d7da;
        border-color: #f1aeb5;
        color: #842029;
    }

    .time-input {
        border-radius: 6px;
        border: 1px solid #e0e0e0;
        font-size: 0.9rem;
        max-width: 130px;
    }

    .btn-save-top {
        border-radius: 8px;
        font-weight: 600;
        padding: 8px 20px;
        transition: transform 0.2s;
    }

        .btn-save-top:hover {
            transform: translateY(-1px);
        }
</style>

<form asp-action="SaveDailyAttendance" method="post">
    <input type="hidden" name="selectedDate" value="@selectedDate.ToString("yyyy-MM-dd")" />

    <div class="container-fluid py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4">
            <div>
                <h4 class="font-weight-bold mb-1 text-dark">Workforce Attendance</h4>
                <p class="text-muted mb-0">Manage and track daily logs for @selectedDate.ToString("MMMM dd, yyyy")</p>
            </div>

            <div class="d-flex align-items-center mt-3 mt-md-0 bg-white p-2 rounded shadow-sm border">
                <div class="mr-3">
                    <label class="small font-weight-bold text-muted d-block mb-0">Switch Date</label>
                    <input type="date" class="form-control form-control-sm border-0 p-0"
                           value="@selectedDate.ToString("yyyy-MM-dd")"
                           onchange="location.href='?date='+this.value" />
                </div>
                <div class="border-left pl-3">
                    <button type="submit" class="btn btn-primary btn-save-top shadow-sm">
                        <i class="fas fa-cloud-upload-alt mr-1"></i> Sync Attendance
                    </button>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4">
                <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                <button class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        <div class="card attendance-card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="pl-4">Employee Details</th>
                            <th class="text-center">Shift</th>
                            <th class="text-center">Check-In / Out</th>
                            <th class="text-center">Attendance Status</th>
                            <th class="pr-4">Observations / Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <input type="hidden" asp-for="@Model[i].EmployeeID" />
                                <input type="hidden" asp-for="@Model[i].EmployeeName" />

                                <td class="pl-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle mr-3">
                                            @Model[i].EmployeeName.Substring(0, 1)
                                        </div>
                                        <div>
                                            <span class="d-block font-weight-bold text-dark">@Model[i].EmployeeName</span>
                                            <span class="badge badge-light border text-muted" style="font-size: 0.7rem;">@Model[i].DepartmentName</span>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-center align-middle">
                                    <div class="small font-weight-bold text-secondary">
                                        <i class="far fa-clock mr-1 text-primary"></i> @Model[i].ShiftName
                                    </div>
                                </td>

                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <input type="time" asp-for="@Model[i].InTime" class="form-control form-control-sm time-input" />
                                        <span class="mx-2 text-muted">→</span>
                                        <input type="time" asp-for="@Model[i].OutTime" class="form-control form-control-sm time-input" />
                                    </div>
                                </td>

                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center">
                                        <div class="status-toggle d-flex gap-1">
                                            <div class="mx-1">
                                                <input type="checkbox" asp-for="@Model[i].IsPresent" id="p_@i" class="check-p">
                                                <label for="p_@i" title="Present">P</label>
                                            </div>
                                            <div class="mx-1">
                                                <input type="checkbox" asp-for="@Model[i].IsLate" id="l_@i" class="check-l">
                                                <label for="l_@i" title="Late">L</label>
                                            </div>
                                            <div class="mx-1">
                                                <input type="checkbox" asp-for="@Model[i].IsHalfDay" id="hd_@i" class="check-hd">
                                                <label for="hd_@i" title="Half Day">HD</label>
                                            </div>
                                            <div class="mx-1">
                                                <input type="checkbox" asp-for="@Model[i].IsOnLeave" id="lv_@i" class="check-lv">
                                                <label for="lv_@i" title="Leave">LV</label>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td class="pr-4 align-middle">
                                    <input type="text" asp-for="@Model[i].Remarks"
                                           class="form-control form-control-sm border-0 bg-light"
                                           placeholder="Add note..." style="border-radius: 6px;" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top py-3 text-right">
                <button type="button" class="btn btn-outline-secondary mr-2" onclick="location.reload();">Discard Changes</button>
                <button type="submit" class="btn btn-primary px-4 font-weight-bold">Update Attendance Records</button>
            </div>
        </div>
    </div>
</form>