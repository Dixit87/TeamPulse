@model IEnumerable<TeamPulse.Models.TblPayrollProcessing>
@{
    ViewData["Title"] = "Payroll Processing";
}

<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.9);
        --payroll-blue: #2563eb;
    }

    .payroll-header {
        background: white;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.5rem 0;
    }

    .card-stat {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        transition: 0.3s;
    }

    .process-panel {
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        border: 1px dashed #bfdbfe;
        border-radius: 16px;
    }

    .table-modern thead th {
        background-color: #f8fafc;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: #475569;
        padding: 15px;
    }

    .employee-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar-init {
        width: 35px;
        height: 35px;
        background: #dbeafe;
        color: #1e40af;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
    }

    .badge-present {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .net-salary-highlight {
        color: #059669;
        font-weight: 800;
        font-size: 1rem;
    }

    /* Animation for "Run Payroll" */
    .btn-run {
        position: relative;
        overflow: hidden;
        transition: 0.3s;
        border-radius: 8px;
        font-weight: 600;
    }

        .btn-run:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
        }
</style>

<div class="payroll-header mb-4">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="font-weight-bold text-dark mb-1">Payroll Command Center</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 m-0">
                        <li class="breadcrumb-item small"><a href="#">Finance</a></li>
                        <li class="breadcrumb-item active small">Monthly Processing</li>
                    </ol>
                </nav>
            </div>
            <div class="col-md-6 text-right">
                <div class="d-inline-flex bg-white p-2 rounded shadow-sm border">
                    <div class="text-left px-3 border-right">
                        <small class="text-muted d-block">Period Selected</small>
                        <span class="font-weight-bold">@ViewBag.SelectedMonth @ViewBag.SelectedYear</span>
                    </div>
                    <div class="text-left px-3">
                        <small class="text-muted d-block">Total Payout</small>
                        <span class="font-weight-bold text-success">₹ @Model?.Sum(x => x.NetSalary ?? 0).ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-custom bg-white border-left border-success shadow-sm alert-dismissible fade show mb-4">
                <div class="d-flex align-items-center">
                    <div class="mr-3 text-success"><i class="fas fa-check-circle fa-2x"></i></div>
                    <div><strong>Batch Processed!</strong><br />@TempData["Success"]</div>
                </div>
                <button class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        <div class="card card-stat mb-5 border-0">
            <div class="card-body p-4 process-panel">
                <div class="row align-items-center">
                    <div class="col-lg-3">
                        <h5 class="font-weight-bold mb-1"><i class="fas fa-bolt text-warning mr-2"></i>Quick Run</h5>
                        <p class="small text-muted mb-lg-0">Calculate dues for the current cycle</p>
                    </div>
                    <div class="col-lg-9">
                        <form asp-action="GeneratePayroll" method="post" class="form-row justify-content-end">
                            <div class="col-md-3">
                                <select name="month" class="form-control border-0 shadow-sm">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(DateTime.Now.Month == i)">
                                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select name="year" class="form-control border-0 shadow-sm">
                                    <option value="2025">2025</option>
                                    <option value="2026" selected>2026</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary btn-block btn-run py-2"
                                        onclick="return confirm('Initiate payroll processing for all active employees?')">
                                    <i class="fas fa-play-circle mr-2"></i> Execute Payroll Run
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-stat border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Disbursement Ledger</h6>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill">
                        <i class="fas fa-download mr-1"></i> Bank Statement (CSV)
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-modern table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="pl-4">Employee Details</th>
                                <th class="text-center">Work Days</th>
                                <th class="text-right">Gross Earnings</th>
                                <th class="text-right text-danger">Statutory Ded.</th>
                                <th class="text-right text-danger">Loan EMI</th>
                                <th class="text-right">Net Payable</th>
                                <th class="text-center">Documents</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="pl-4 align-middle">
                                            <div class="employee-cell">
                                                <div class="avatar-init">@(item.Employee.FirstName?[0])</div>
                                                <div>
                                                    <div class="font-weight-bold text-dark">@item.Employee.FirstName @item.Employee.LastName</div>
                                                    <div class="small text-muted">ID: #EMP-@item.EmployeeId</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span class="badge badge-present px-3 py-2">
                                                <i class="far fa-calendar-check mr-1"></i> @((item.PresentDays ?? 0).ToString("0.##"))
                                            </span>
                                        </td>
                                        <td class="text-right align-middle font-weight-bold text-dark">
                                            ₹ @((item.TotalGross ?? 0).ToString("N0"))
                                        </td>
                                        <td class="text-right align-middle text-danger small">
                                            ₹ @((item.TotalDeductions ?? 0).ToString("N0"))
                                        </td>
                                        <td class="text-right align-middle">
                                            @if ((item.LoanDeducted ?? 0) > 0)
                                            {
                                                <span class="text-danger font-weight-bold small">₹ @((item.LoanDeducted ?? 0).ToString("N0"))</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td class="text-right align-middle">
                                            <span class="net-salary-highlight">₹ @((item.NetSalary ?? 0).ToString("N0"))</span>
                                        </td>
                                        <td class="text-center align-middle">
                                            <a href="@Url.Action("SalarySlip", "Payroll", new { id = item.PayrollId })"
                                               target="_blank" class="btn btn-sm btn-light border rounded-pill px-3 shadow-sm hover-primary">
                                                <i class="fas fa-file-pdf text-danger mr-1"></i> Payslip
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" style="width: 80px; opacity: 0.3;" />
                                        <h6 class="mt-3 text-muted">Waiting for execution. Please run payroll to see results.</h6>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>