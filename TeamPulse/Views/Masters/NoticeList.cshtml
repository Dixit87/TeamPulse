@model IEnumerable<TeamPulse.Models.TblNotice>
@{
    ViewData["Title"] = "Notice Board Management";
}

<style>
    /* Aapke Holiday page se matching style */
    .notice-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
    }

    .table thead th {
        background-color: #f8fafc;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        color: #64748b;
        border: none;
    }

    .table td {
        vertical-align: middle !important;
        border-bottom: 1px solid #f1f5f9;
        padding: 1.2rem 1rem;
    }

    .btn-action {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        transition: 0.3s;
        border: none;
    }

    .btn-edit-soft {
        background: #e0f2fe;
        color: #0369a1;
    }

    .btn-delete-soft {
        background: #fee2e2;
        color: #b91c1c;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .notice-icon-circle {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fef2f2;
        color: #ef4444;
        font-size: 1.2rem;
    }
</style>

<div class="content-header py-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <div>  
                <h2 class="font-weight-bold text-dark mb-0">Notice Board</h2>
                <p class="text-muted small mb-0"><i class="fas fa-bullhorn mr-1"></i> Broadcast important announcements to all employees</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm font-weight-bold" onclick="openNoticeModal(0, '', '')">
                <i class="fas fa-plus-circle mr-1"></i> Create Notice
            </button>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Success"] != null)
        {
            <div class="alert bg-white border-left border-success shadow-sm alert-dismissible fade show mb-4">
                <i class="fas fa-check-circle text-success mr-2"></i> @TempData["Success"]
                <button class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        <div class="card notice-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="pl-4">Notice Info</th>
                                <th>Announcement</th>
                                <th>Date Posted</th>
                                <th class="text-right pr-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="pl-4">
                                        <div class="notice-icon-circle shadow-sm">
                                            <i class="fas fa-bell"></i>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@item.Title</div>
                                        <div class="text-muted small text-truncate" style="max-width: 400px;">@item.Description</div>
                                    </td>
                                    <td>
                                        <span class="badge badge-light border px-3 py-2 text-dark">
                                            <i class="far fa-calendar-alt mr-1 text-primary"></i> @item.PostedDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td class="text-right pr-4">
                                        <button class="btn-action btn-edit-soft mr-2" onclick="openNoticeModal(@item.NoticeId, '@item.Title', '@item.Description')" title="Edit">
                                            <i class="fas fa-pen-nib"></i>
                                        </button>
                                        <a href="@Url.Action("DeleteNotice", new { id = item.NoticeId })" class="btn-action btn-delete-soft" onclick="return confirm('Remove this announcement?');" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="noticeModal">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0" style="border-radius: 24px;">
            <div class="modal-header bg-white border-0 p-4 pb-0">
                <h5 class="font-weight-bold text-dark" id="ntcModalTitle">Create Announcement</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <form asp-action="SaveNotice" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="NoticeId" id="ntcId" value="0" />
                    <div class="form-group mb-4">
                        <label class="small font-weight-bold text-muted text-uppercase">Notice Title</label>
                        <input type="text" name="Title" id="ntcTitle" class="form-control" style="border-radius:12px; background:#f8fafc;" required placeholder="e.g. Monthly Staff Meeting" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="small font-weight-bold text-muted text-uppercase">Description</label>
                        <textarea name="Description" id="ntcDesc" class="form-control" rows="5" style="border-radius:12px; background:#f8fafc;" required placeholder="Write the full details here..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow">Publish Notice</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openNoticeModal(id, title, desc) {
            $('#ntcId').val(id);
            $('#ntcTitle').val(title);
            $('#ntcDesc').val(desc);

            if (id === 0) {
                $('#ntcModalTitle').html('<i class="fas fa-bullhorn text-primary mr-2"></i>Create New Announcement');
            } else {
                $('#ntcModalTitle').html('<i class="fas fa-edit text-primary mr-2"></i>Modify Announcement');
            }
            $('#noticeModal').modal('show');
        }
    </script>
}