@model IEnumerable<TeamPulse.ViewModels.DesignationVM>
@{
    ViewData["Title"] = "Role Architecture";
}

<style>
    /* Card & Shadow effects */
    .glass-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        background: #ffffff;
    }

    /* Table Header Styling */
    .table thead th {
        background-color: #f8fafc;
        text-transform: uppercase;
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        color: #64748b;
        border: none;
        padding: 1.2rem;
    }

    /* Table Body Styling */
    .table td {
        padding: 1rem 1.2rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    /* Modern Badges */
    .badge-dept {
        background-color: #e0f2fe;
        color: #0369a1;
        font-weight: 600;
        border-radius: 8px;
        padding: 6px 12px;
    }

    .status-dot {
        height: 8px;
        width: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
    }

    /* Action Buttons */
    .btn-circle {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        border: none;
    }

    .btn-edit-soft {
        background: #fef3c7;
        color: #92400e;
    }

        .btn-edit-soft:hover {
            background: #92400e;
            color: #fff;
        }

    .btn-delete-soft {
        background: #fee2e2;
        color: #b91c1c;
    }

        .btn-delete-soft:hover {
            background: #b91c1c;
            color: #fff;
        }

    /* Modal Styling */
    .modal-content {
        border: none;
        border-radius: 20px;
    }

    .form-modern {
        border-radius: 10px;
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
    }

        .form-modern:focus {
            background: #fff;
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }
</style>

<div class="content-header py-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="font-weight-bold text-dark mb-0">Role & Designations</h2>
                <p class="text-muted small"><i class="fas fa-id-badge mr-1"></i> Configure job roles and their departmental mapping</p>
            </div>
            <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm font-weight-bold" onclick="openModal(0, '', 0)">
                <i class="fas fa-plus-circle mr-1"></i> Define New Role
            </button>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert bg-white border-left border-success shadow-sm alert-dismissible fade show mb-4">
                <i class="fas fa-check-circle text-success mr-2"></i> @TempData["Success"]
                <button class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        <div class="card glass-card border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="pl-4">Official Designation</th>
                                <th>Department Mapping</th>
                                <th class="text-center">Status</th>
                                <th class="text-right pr-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="pl-4">
                                        <div class="font-weight-bold text-dark">@item.DesignationName</div>
                                        <small class="text-muted text-uppercase" style="font-size: 10px;">ID: #DES-@item.DesignationID</small>
                                    </td>
                                    <td>
                                        <span class="badge badge-dept">
                                            <i class="fas fa-folder-open mr-1 small"></i> @item.DepartmentName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="text-success small font-weight-bold">
                                                <span class="status-dot bg-success"></span> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small font-weight-bold">
                                                <span class="status-dot bg-secondary"></span> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="text-right pr-4">
                                        <button class="btn-circle btn-edit-soft mr-2"
                                                onclick="openModal(@item.DesignationID, '@item.DesignationName', @item.DepartmentID)"
                                                title="Modify Role">
                                            <i class="fas fa-pen-nib"></i>
                                        </button>

                                        <a href="@Url.Action("DeleteDesignation", "Masters", new { id = item.DesignationID })"
                                           class="btn-circle btn-delete-soft"
                                           onclick="return confirm('Archive this role from system?');"
                                           title="Delete Role">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="desigModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header border-0 p-4">
                <h5 class="modal-title font-weight-bold text-dark" id="modalTitle">Role Configuration</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <form asp-action="SaveDesignation" asp-controller="Masters" method="post">
                <div class="modal-body p-4 pt-0">
                    <input type="hidden" name="DesignationID" id="hdnId" value="0" />

                    <div class="form-group mb-4">
                        <label class="small font-weight-bold text-muted text-uppercase">Parent Department</label>
                        <select name="DepartmentID" id="ddlDept" class="form-control form-modern custom-select" asp-items="ViewBag.DeptList" required>
                            <option value="">-- Assign to Department --</option>
                        </select>
                    </div>

                    <div class="form-group mb-0">
                        <label class="small font-weight-bold text-muted text-uppercase">Role Title</label>
                        <input type="text" name="DesignationName" id="txtName" class="form-control form-modern" required placeholder="e.g. Lead UI/UX Designer" />
                        <small class="text-muted mt-2 d-block">Ensure the title matches the official organizational chart.</small>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow">Commit Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id, name, deptId) {
            $('#hdnId').val(id);
            $('#txtName').val(name);
            $('#ddlDept').val(deptId);

            if (id === 0) {
                $('#modalTitle').html('<i class="fas fa-plus-circle text-primary mr-2"></i>Establish New Role');
                $('#ddlDept').val("");
            } else {
                $('#modalTitle').html('<i class="fas fa-edit text-primary mr-2"></i>Refine Role Title');
            }
            $('#desigModal').modal('show');
        }
    </script>
}