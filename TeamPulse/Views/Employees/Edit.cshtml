@model TeamPulse.ViewModels.EmployeeVM
@{
    ViewData["Title"] = "Update Talent Profile - " + Model.FirstName;
}

<style>
    :root {
        --input-focus: #4f46e5;
        --bg-light: #f8fafc;
    }

    .edit-container {
        padding: 1.5rem 0;
    }

    /* Modern Card UI */
    .glass-card {
        border: none;
        border-radius: 24px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        background: #fff;
    }

    /* Profile Upload Section */
    .profile-upload-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 1.5rem;
    }

    .profile-user-img {
        width: 160px;
        height: 160px;
        object-fit: cover;
        border: 4px solid #fff;
        box-shadow: 0 8px 16px rgba(0,0,0,0.1);
        border-radius: 40px;
        transition: 0.3s;
    }

    .upload-overlay {
        position: absolute;
        bottom: 5px;
        right: 5px;
        background: #4f46e5;
        color: #fff;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 3px solid #fff;
        transition: 0.2s;
    }

        .upload-overlay:hover {
            transform: scale(1.1);
            background: #3730a3;
        }

    /* Form Styling */
    .form-group label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 6px;
    }

    .form-control-modern {
        border-radius: 12px;
        padding: 0.75rem 1rem;
        background: var(--bg-light);
        border: 1px solid #e2e8f0;
        font-weight: 500;
        color: #1e293b;
        transition: 0.3s;
    }

        .form-control-modern:focus {
            background: #fff;
            border-color: var(--input-focus);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

    /* Tab Navigation */
    .nav-tabs-modern {
        border: none;
        background: #f1f5f9;
        padding: 6px;
        border-radius: 16px;
        margin-bottom: 2rem;
    }

        .nav-tabs-modern .nav-link {
            border: none;
            border-radius: 12px;
            color: #64748b;
            font-weight: 600;
            padding: 10px 25px;
            transition: 0.3s;
        }

            .nav-tabs-modern .nav-link.active {
                background: #fff;
                color: #4f46e5;
                box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            }

    .section-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1.5rem;
        border-left: 4px solid #4f46e5;
        padding-left: 12px;
    }
</style>

<div class="edit-container">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="font-weight-bold text-dark mb-0">Update Talent Profile</h2>
                <p class="text-muted small">ID: #EMP-@Model.EmployeeID.ToString("D4") &bull; @Model.Email</p>
            </div>
            <a href="@Url.Action("Index")" class="btn btn-light rounded-pill px-4 border shadow-sm">
                <i class="fas fa-times mr-2"></i> Cancel
            </a>
        </div>

        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="EmployeeID" />
            <input type="hidden" asp-for="ExistingPhotoPath" />
            <input type="hidden" asp-for="Password" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="IsActive" />

            <div class="row">
                <div class="col-lg-3">
                    <div class="card glass-card text-center py-5 px-3 mb-4">
                        <div class="profile-upload-wrapper">
                            @if (!string.IsNullOrEmpty(Model.ExistingPhotoPath))
                            {
                                <img id="imgPreview" class="profile-user-img" src="~/uploads/employees/@Model.ExistingPhotoPath">
                            }
                            else
                            {
                                <img id="imgPreview" class="profile-user-img" src="~/theme/dist/img/user2-160x160.jpg">
                            }
                            <label for="customFile" class="upload-overlay">
                                <i class="fas fa-camera"></i>
                            </label>
                            <input type="file" asp-for="ProfilePhoto" class="d-none" id="customFile" onchange="previewImage(this)">
                        </div>

                        <h5 class="font-weight-bold text-dark mb-1">@Model.FirstName @Model.LastName</h5>
                        <p class="text-primary small font-weight-bold mb-4">@Model.DesignationName</p>

                        <div class="alert bg-light border-0 small text-muted text-left">
                            <i class="fas fa-info-circle text-primary mr-2"></i> Use a professional headshot for better directory visibility.
                        </div>
                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="card glass-card">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                            <ul class="nav nav-tabs nav-tabs-modern" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-toggle="pill" href="#tab_personal">Personal Details</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-toggle="pill" href="#tab_official">Job & Salary</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-toggle="pill" href="#tab_bank">Bank & Statutory</a>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body p-4">
                            <div class="tab-content">
                                <div class="tab-pane fade show active" id="tab_personal">
                                    <h6 class="section-title">Identity Information</h6>
                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label>First Name</label>
                                            <input asp-for="FirstName" class="form-control form-control-modern" placeholder="Legal First Name" />
                                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Last Name</label>
                                            <input asp-for="LastName" class="form-control form-control-modern" placeholder="Surname" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label>Primary Mobile</label>
                                            <input asp-for="MobileNumber" class="form-control form-control-modern" placeholder="+91" />
                                            <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label>Date of Birth</label>
                                            <input asp-for="DateOfBirth" type="date" class="form-control form-control-modern" value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label>Gender Identity</label>
                                            <select asp-for="Gender" class="form-control form-control-modern custom-select">
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                    </div>

                                    <h6 class="section-title mt-4">Address Records</h6>
                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label>Current Residence</label>
                                            <textarea asp-for="CurrentAddress" class="form-control form-control-modern" rows="3" placeholder="Street, City, Pincode..."></textarea>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Permanent Address</label>
                                            <textarea asp-for="PermanentAddress" class="form-control form-control-modern" rows="3" placeholder="As per National ID..."></textarea>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="tab_official">
                                    <h6 class="section-title">Organization Mapping</h6>
                                    <div class="row">
                                        <div class="col-md-4 form-group">
                                            <label>Assigned Unit</label>
                                            <select asp-for="DepartmentID" class="form-control form-control-modern custom-select" asp-items="ViewBag.Departments"></select>
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label>Job Designation</label>
                                            <select asp-for="DesignationID" class="form-control form-control-modern custom-select" asp-items="ViewBag.Designations"></select>
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label>Work Roster (Shift)</label>
                                            <select asp-for="ShiftID" class="form-control form-control-modern custom-select" asp-items="ViewBag.Shifts"></select>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Commencement Date (DOJ)</label>
                                            <input asp-for="DateOfJoining" type="date" class="form-control form-control-modern" value="@Model.DateOfJoining.ToString("yyyy-MM-dd")" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Base Remuneration (₹)</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend"><span class="input-group-text bg-transparent border-right-0" style="border-radius: 12px 0 0 12px;">₹</span></div>
                                                <input asp-for="BasicSalary" type="number" class="form-control form-control-modern border-left-0" style="border-radius: 0 12px 12px 0;" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="bg-light p-3 rounded-lg mt-3">
                                        <small class="text-muted"><i class="fas fa-lock mr-1"></i> Security: Login email <b>(@Model.Email)</b> is locked for administrative reasons.</small>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="tab_bank">
                                    <h6 class="section-title">Disbursement Account</h6>
                                    <div class="row">
                                        <div class="col-md-4 form-group">
                                            <label>Bank Partner</label>
                                            <input asp-for="BankName" class="form-control form-control-modern" placeholder="e.g. HDFC" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label>Account Number</label>
                                            <input asp-for="AccountNumber" class="form-control form-control-modern" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label>IFSC Code</label>
                                            <input asp-for="Ifsccode" class="form-control form-control-modern" />
                                        </div>
                                    </div>

                                    <h6 class="section-title mt-4">Statutory Compliance Numbers</h6>
                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label>PAN (Income Tax)</label>
                                            <input asp-for="PANNumber" class="form-control form-control-modern" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Aadhar Number</label>
                                            <input asp-for="AadharNumber" class="form-control form-control-modern" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Provident Fund (PF)</label>
                                            <input asp-for="PFNumber" class="form-control form-control-modern" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>UAN Number</label>
                                            <input asp-for="UANNumber" class="form-control form-control-modern" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 p-4 text-right">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow">
                                <i class="fas fa-check-circle mr-2"></i> Save Talent Profile
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#imgPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}