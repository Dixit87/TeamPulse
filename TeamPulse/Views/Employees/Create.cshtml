@model TeamPulse.ViewModels.EmployeeVM
@{
    ViewData["Title"] = "Add New Employee";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">New Employee Registration</h1></div>
            <div class="col-sm-6 text-right">
                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
        </div>
    </div>

<section class="content">
    <div class="container-fluid">
        <form asp-action="Create" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-3">
                    <div class="card card-primary card-outline">
                        <div class="card-body box-profile text-center">
                            <img id="imgPreview" class="profile-user-img img-fluid img-circle" src="~/theme/dist/img/user2-160x160.jpg" style="width:150px;height:150px;object-fit:cover;">
                            <div class="mt-3">
                                <label>Upload Photo</label>
                                <input type="file" asp-for="ProfilePhoto" class="form-control p-1" onchange="previewImage(this)" />
                                <span asp-validation-for="ProfilePhoto" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-9">
                    <div class="card card-primary card-tabs">
                        <div class="card-header p-0 pt-1">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item"><a class="nav-link active" data-toggle="pill" href="#tab_1">Personal</a></li>
                                <li class="nav-item"><a class="nav-link" data-toggle="pill" href="#tab_2">Official</a></li>
                                <li class="nav-item"><a class="nav-link" data-toggle="pill" href="#tab_3">Banking & Statutory</a></li>
                            </ul>
                        </div>
                        <div class="card-body">
                            <div class="tab-content">
                                <div class="tab-pane fade show active" id="tab_1">
                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label>First Name <span class="text-danger">*</span></label>
                                            <input asp-for="FirstName" class="form-control" placeholder="Enter First Name" />
                                            <span asp-validation-for="FirstName" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Last Name</label>
                                            <input asp-for="LastName" class="form-control" placeholder="Enter Last Name" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Mobile <span class="text-danger">*</span></label>
                                            <input asp-for="MobileNumber" class="form-control" placeholder="10 Digit Mobile" />
                                            <span asp-validation-for="MobileNumber" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Gender</label>
                                            <select asp-for="Gender" class="form-control">
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Date of Birth</label>
                                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                                        </div>
                                        <div class="col-md-12 form-group">
                                            <label>Current Address</label>
                                            <textarea asp-for="CurrentAddress" class="form-control" rows="2"></textarea>
                                        </div>
                                        <div class="col-md-12 form-group">
                                            <label>Permanent Address</label>
                                            <textarea asp-for="PermanentAddress" class="form-control" rows="2"></textarea>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="tab_2">
                                    <div class="row">
                                        <div class="col-md-4 form-group"><label>Department</label><select asp-for="DepartmentID" class="form-control" asp-items="ViewBag.Departments"><option value="">Select</option></select></div>
                                        <div class="col-md-4 form-group"><label>Designation</label><select asp-for="DesignationID" class="form-control" asp-items="ViewBag.Designations"><option value="">Select</option></select></div>
                                        <div class="col-md-4 form-group"><label>Shift</label><select asp-for="ShiftID" class="form-control" asp-items="ViewBag.Shifts"><option value="">Select</option></select></div>

                                        <div class="col-md-6 form-group">
                                            <label>Date of Joining <span class="text-danger">*</span></label>
                                            <input asp-for="DateOfJoining" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Basic Salary <span class="text-danger">*</span></label>
                                            <input asp-for="BasicSalary" type="number" class="form-control" />
                                        </div>

                                        <div class="col-12"><hr /></div>
                                        <div class="col-md-6 form-group">
                                            <label>Login Email <span class="text-danger">*</span></label>
                                            <input asp-for="Email" class="form-control" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label>Password <span class="text-danger">*</span></label>
                                            <input asp-for="Password" class="form-control" value="Welcome@123" />
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="tab_3">
                                    <h6 class="text-primary font-weight-bold">Bank Accounts</h6>
                                    <div class="row">
                                        <div class="col-md-4 form-group"><label>Bank Name</label><input asp-for="BankName" class="form-control" placeholder="e.g. HDFC" /></div>
                                        <div class="col-md-4 form-group"><label>Account No</label><input asp-for="AccountNumber" class="form-control" /></div>
                                        <div class="col-md-4 form-group"><label>IFSC Code</label><input asp-for="Ifsccode" class="form-control" /></div>
                                    </div>
                                    <hr />
                                    <h6 class="text-primary font-weight-bold">Statutory Identifiers</h6>
                                    <div class="row">
                                        <div class="col-md-6 form-group"><label>PAN Number</label><input asp-for="PANNumber" class="form-control" /></div>
                                        <div class="col-md-6 form-group"><label>Aadhar Number</label><input asp-for="AadharNumber" class="form-control" /></div>
                                        <div class="col-md-6 form-group"><label>PF Number</label><input asp-for="PFNumber" class="form-control" /></div>
                                        <div class="col-md-6 form-group"><label>UAN Number</label><input asp-for="UANNumber" class="form-control" /></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-right">
                            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Save Employee</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) { $('#imgPreview').attr('src', e.target.result); }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}