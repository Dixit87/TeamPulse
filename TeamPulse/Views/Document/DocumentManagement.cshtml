@model IEnumerable<TeamPulse.Models.TblEmployeeDocument>
@{
    ViewData["Title"] = "Employee Document Vault";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">

<style>
    .doc-stat-card {
        border-radius: 15px;
        border: none;
        transition: 0.3s;
    }

        .doc-stat-card:hover {
            transform: translateY(-5px);
        }

    .table-modern {
        background: white;
        border-radius: 12px;
        overflow: hidden;
    }

        .table-modern thead th {
            background-color: #f8fafc;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            border: none;
            color: #64748b;
        }

    .file-icon {
        font-size: 2rem;
    }

    .custom-file-label::after {
        background-color: #4361ee;
        color: white;
    }
</style>

<section class="content-header py-4">
    <div class="container-fluid">
        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="font-weight-bold mb-1"><i class="fas fa-folder-open text-primary mr-2"></i>Document Vault</h2>
                <p class="text-muted">Securely manage and organize employee documents, IDs, and contracts.</p>
            </div>
            <div class="col-md-6 text-right">
                <button class="btn btn-primary shadow-sm rounded-pill px-4 py-2 font-weight-bold" data-toggle="modal" data-target="#uploadModal">
                    <i class="fas fa-cloud-upload-alt mr-2"></i> Upload New Document
                </button>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card doc-stat-card bg-white shadow-sm border-left border-primary" style="border-left-width: 4px !important;">
                    <div class="card-body">
                        <small class="text-uppercase text-muted font-weight-bold">Total Documents</small>
                        <h3 class="font-weight-bold text-dark mb-0">@Model.Count() <small class="text-muted" style="font-size:1rem;">Files</small></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card doc-stat-card bg-white shadow-sm border-left border-success" style="border-left-width: 4px !important;">
                    <div class="card-body">
                        <small class="text-uppercase text-muted font-weight-bold">Recent Uploads (Last 7 Days)</small>
                        <h3 class="font-weight-bold text-dark mb-0">@Model.Count(d => d.UploadedDate >= DateTime.Now.AddDays(-7))</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm table-modern p-3">
            <div class="card-body p-0">
                <table id="docTable" class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>File</th>
                            <th>Document Name</th>
                            <th>Employee Details</th>
                            <th>Upload Date</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            // Smart Icon Logic based on File Extension
                            string ext = System.IO.Path.GetExtension(item.FilePath)?.ToLower() ?? "";
                            string iconClass = "fa-file-alt text-secondary"; // Default Icon

                            if (ext == ".pdf") iconClass = "fa-file-pdf text-danger";
                            else if (ext == ".png" || ext == ".jpg" || ext == ".jpeg") iconClass = "fa-file-image text-success";
                            else if (ext == ".doc" || ext == ".docx") iconClass = "fa-file-word text-primary";
                            else if (ext == ".xls" || ext == ".xlsx") iconClass = "fa-file-excel text-success";

                            <tr>
                                <td style="width: 60px;" class="text-center">
                                    <i class="fas @iconClass file-icon"></i>
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark" style="font-size: 1.1rem;">@item.DocumentName</div>
                                    <small class="text-muted">Ext: <span class="text-uppercase">@ext.Replace(".", "")</span></small>
                                </td>
                                <td>
                                    <div class="font-weight-bold text-primary">
                                        <i class="fas fa-user-circle mr-1"></i> @item.Employee?.FirstName @item.Employee?.LastName
                                    </div>
                                    <small class="text-muted">EMP ID: #@item.EmployeeId</small>
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark">@item.UploadedDate?.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@item.UploadedDate?.ToString("hh:mm tt")</small>
                                </td>
                                <td class="text-center">
                                    <a href="~/uploads/documents/@item.FilePath" download="@item.DocumentName@ext" class="btn btn-sm btn-light rounded-circle text-primary shadow-sm mr-2" title="Download">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <a href="@Url.Action("DeleteDocument", "Document", new { id = item.DocumentId })" class="btn btn-sm btn-light rounded-circle text-danger shadow-sm" title="Delete" onclick="return confirm('Are you sure you want to delete this document permanently?');">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-folder-open fa-3x text-muted mb-3 opacity-25"></i>
                        <h5 class="font-weight-bold text-dark">No Documents Found</h5>
                        <p class="text-muted mb-0">Upload employee documents like Offer Letters, ID Proofs, etc.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="uploadModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title font-weight-bold text-dark"><i class="fas fa-cloud-upload-alt text-primary mr-2"></i>Upload Document</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <form asp-action="UploadDocument" asp-controller="Document" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">

                    <div class="form-group mb-4">
                        <label class="small font-weight-bold text-uppercase text-muted">Select Employee</label>
                        <select name="EmployeeId" class="form-control form-control-lg border-primary" asp-items="ViewBag.Employees" style="border-radius: 10px;" required>
                            <option value="">-- Search Employee --</option>
                        </select>
                    </div>

                    <div class="form-group mb-4">
                        <label class="small font-weight-bold text-uppercase text-muted">Document Name / Title</label>
                        <input type="text" name="DocumentName" class="form-control form-control-lg" placeholder="e.g. Offer Letter, Aadhar Card, PAN..." style="border-radius: 10px;" required />
                    </div>

                    <div class="form-group mb-4">
                        <label class="small font-weight-bold text-uppercase text-muted">Choose File (PDF, JPG, PNG)</label>
                        <div class="custom-file">
                            <input type="file" name="DocumentFile" class="custom-file-input" id="customFile" required accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                            <label class="custom-file-label" for="customFile" style="border-radius: 10px;">Select file...</label>
                        </div>
                    </div>

                    <div class="alert alert-warning small border-0 mb-0" style="border-radius: 10px;">
                        <i class="fas fa-shield-alt mr-1"></i> This document will be securely vaulted and visible to the selected employee.
                    </div>

                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-sm font-weight-bold" style="border-radius: 10px;">
                        <i class="fas fa-upload mr-2"></i> Upload Securely
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function() {
            // File upload name display logic
            $(".custom-file-input").on("change", function() {
                var fileName = $(this).val().split("\\").pop();
                $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
            });

            // DataTable Initialization
            if ($('#docTable tbody tr').length > 0 && !$('#docTable tbody tr td').hasClass('dataTables_empty')) {
                $('#docTable').DataTable({
                    "pageLength": 10,
                    "ordering": false,
                    "language": {
                        "search": "",
                        "searchPlaceholder": "Search documents..."
                    }
                });
                $('.dataTables_filter input').addClass('form-control form-control-sm').css({'border-radius':'8px'});
            }
        });
    </script>
}